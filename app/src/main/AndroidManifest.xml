<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:name=".PassPonyApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.PassPony"
        android:localeConfig="@xml/locales_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.PassPony">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Required for AppCompatDelegate.setApplicationLocales() to persist
          across process restarts on API 26-32 (API 33+ delegates straight
          to the platform LocaleManager and needs none of this; see
          LanguageManager.kt). Without this, a locale picked on an old
          device would apply for the current session only and silently
          revert to system default on next launch.
        -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

        <!--
          P12: both autofill activities are only ever started by the
          system itself, via the PendingIntents PassPonyAutofillService
          attaches to a Dataset's authentication - never by another app,
          so both are unexported.
        -->
        <activity
            android:name=".autofill.AutofillAuthActivity"
            android:exported="false"
            android:theme="@style/Theme.PassPony.Translucent"
            android:excludeFromRecents="true" />

        <activity
            android:name=".autofill.AutofillPickerActivity"
            android:exported="false"
            android:theme="@style/Theme.PassPony"
            android:excludeFromRecents="true" />

        <service
            android:name=".autofill.PassPonyAutofillService"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service_config" />
        </service>

    </application>

</manifest>
