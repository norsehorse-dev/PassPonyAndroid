<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app locale list for API 33+ (AppCompatDelegate delegates to the
  platform LocaleManager there). P13 lands the other six languages
  alongside their strings.xml resources (see scripts/xcstrings_to_strings.py).
-->
<locale-config xmlns:android="http://schemas.android.com/apk/res/android">
    <locale android:name="en" />
    <locale android:name="es" />
    <locale android:name="fr" />
    <locale android:name="de" />
    <locale android:name="ru" />
    <locale android:name="zh-Hans" />
    <locale android:name="pt-BR" />
</locale-config>
